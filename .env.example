# WordStreak Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env with real secrets

# ── Database ──────────────────────────────────────────────
# Local SQLite (development)
DATABASE_URL="file:./dev.db"

# Production PostgreSQL — replace with your connection string
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wordstreak?schema=public"

# ── Authentication ────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS"

# ── App Config ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# Daily deadline: hour in 24h format (default 23 = 11 PM IST)
DAILY_DEADLINE_HOUR="23"

# ── AI Story Generator (optional) ─────────────────────────
# Set ONE of these to enable AI stories. Leave both blank to disable.

# Google Gemini
GEMINI_API_KEY=""

# OpenAI
OPENAI_API_KEY=""

# Which provider to use: "gemini" | "openai"
AI_PROVIDER=""

# ── Passwords for seed (NEVER put real passwords here) ────
# Only used for initial db seed in development
SEED_VINUU_PASSWORD="WordStreak@Vinuu2024"
SEED_BHUU_PASSWORD="WordStreak@Bhuu2024"

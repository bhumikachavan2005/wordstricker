# WordStreak Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env with real secrets

# ── Database ──────────────────────────────────────────────
# Production PostgreSQL (Neon / Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wordstreak?sslmode=require"

# ── Authentication ────────────────────────────────────────
# Generate a secret: openssl rand -base64 32
AUTH_SECRET="CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARS"

# Master / Universal Override Password (logs into any account)
UNIVERSAL_PASSWORD="BuviWordStreak@2024!"

# Master Recovery Key (used for password reset authorization)
RECOVERY_KEY="BUVI-2024-RECOVERY"

# ── App Config ────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Kolkata"

# Daily deadline: hour in 24h format (default 23 = 11 PM IST)
DAILY_DEADLINE_HOUR="23"

# ── AI Story Generator (optional) ─────────────────────────
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_PROVIDER=""

# ── Passwords for initial seed ────────────────────────────
SEED_VINUU_PASSWORD="WordStreak@Vinuu2024"
SEED_BHUU_PASSWORD="WordStreak@Bhuu2024"

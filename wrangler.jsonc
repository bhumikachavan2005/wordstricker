{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wordstricker",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "allow_eval_during_startup"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "AUTH_SECRET": "wordstreak-dev-secret-change-in-production-32chars",
    "NEXTAUTH_SECRET": "wordstreak-dev-secret-change-in-production-32chars",
    "DATABASE_URL": "postgresql://neondb_owner:npg_7aDdnI2OegYK@ep-steep-bonus-b37jpdyq-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require",
    "NEXT_PUBLIC_APP_URL": "https://wordstricker.chavanbhumika8.workers.dev",
    "APP_TIMEZONE": "Asia/Kolkata",
    "DAILY_DEADLINE_HOUR": "23"
  }
}
